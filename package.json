{
  "name": "fundamentool",
  "version": "1.4.0",
  "description": "TypeScript utility library — strings, objects, arrays, async, type predicates, RPC, JSONL, Node.js and browser utilities",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "async": [
        "dist/async/index.d.ts"
      ],
      "is": [
        "dist/is/index.d.ts"
      ],
      "schema": [
        "dist/schema/index.d.ts"
      ],
      "i18n": [
        "dist/i18n/index.d.ts"
      ],
      "i18n/vite": [
        "dist/i18n/vite/index.d.ts"
      ],
      "i18n/testing": [
        "dist/i18n/testing/index.d.ts"
      ],
      "join": [
        "dist/join/index.d.ts"
      ],
      "split": [
        "dist/split/index.d.ts"
      ],
      "jsonl": [
        "dist/jsonl/index.d.ts"
      ],
      "scheduler": [
        "dist/scheduler/index.d.ts"
      ],
      "rpc": [
        "dist/rpc/index.d.ts"
      ],
      "browser": [
        "dist/browser/index.d.ts"
      ],
      "node": [
        "dist/node/index.d.ts"
      ],
      "rpc/browser": [
        "dist/rpc/browser/index.d.ts"
      ],
      "rpc/node": [
        "dist/rpc/node/index.d.ts"
      ],
      "vdom": [
        "dist/vdom/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md"
  ],
  "sideEffects": false,
  "scripts": {
    "docs:api": "typedoc --options ./typedoc.json",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix --quiet",
    "test": "jest --config=./jest.config.js",
    "test:watch": "jest --watch --no-coverage --config=./jest.config.js",
    "test:coverage": "jest --coverage --config=./jest.config.js",
    "validate": "pnpm lint && pnpm test",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm build && pnpm test:dist",
    "test:dist": "node scripts/check-dist.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "import": "./dist/esm/async/index.js",
      "default": "./dist/async/index.js"
    },
    "./is": {
      "types": "./dist/is/index.d.ts",
      "import": "./dist/esm/is/index.js",
      "default": "./dist/is/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/esm/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/esm/i18n/index.js",
      "default": "./dist/i18n/index.js"
    },
    "./i18n/vite": {
      "types": "./dist/i18n/vite/index.d.ts",
      "import": "./dist/esm/i18n/vite/index.js",
      "default": "./dist/i18n/vite/index.js"
    },
    "./i18n/testing": {
      "types": "./dist/i18n/testing/index.d.ts",
      "import": "./dist/esm/i18n/testing/index.js",
      "default": "./dist/i18n/testing/index.js"
    },
    "./join": {
      "types": "./dist/join/index.d.ts",
      "import": "./dist/esm/join/index.js",
      "default": "./dist/join/index.js"
    },
    "./split": {
      "types": "./dist/split/index.d.ts",
      "import": "./dist/esm/split/index.js",
      "default": "./dist/split/index.js"
    },
    "./jsonl": {
      "types": "./dist/jsonl/index.d.ts",
      "import": "./dist/esm/jsonl/index.js",
      "default": "./dist/jsonl/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/esm/scheduler/index.js",
      "default": "./dist/scheduler/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/esm/rpc/index.js",
      "default": "./dist/rpc/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/esm/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/esm/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./rpc/browser": {
      "types": "./dist/rpc/browser/index.d.ts",
      "import": "./dist/esm/rpc/browser/index.js",
      "default": "./dist/rpc/browser/index.js"
    },
    "./rpc/node": {
      "types": "./dist/rpc/node/index.d.ts",
      "import": "./dist/esm/rpc/node/index.js",
      "default": "./dist/rpc/node/index.js"
    },
    "./vdom": {
      "types": "./dist/vdom/index.d.ts",
      "import": "./dist/esm/vdom/index.js",
      "default": "./dist/vdom/index.js"
    }
  },
  "keywords": [
    "typescript",
    "utils",
    "utilities",
    "rpc",
    "async",
    "jsonl",
    "browser",
    "node",
    "string",
    "object",
    "array"
  ],
  "author": "Amir Absaliamov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-amirka/fundamentool.git"
  },
  "homepage": "https://github.com/mr-amirka/fundamentool#readme",
  "bugs": {
    "url": "https://github.com/mr-amirka/fundamentool/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-lab": "github:mr-amirka/eslint-config-lab#9238feb561678405da80afe8ce7dfc379a7160b5",
    "fast-check": "^4.8.0",
    "globals": "^13.24.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "node-notifier": "^10.0.1",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
