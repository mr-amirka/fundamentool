{
  "name": "fundamentool",
  "version": "2.0.0",
  "description": "TypeScript utility library — strings, objects, arrays, async, type predicates, RPC, JSONL, Node.js and browser utilities",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.ru.md"
  ],
  "sideEffects": false,
  "scripts": {
    "docs:api": "typedoc --options ./typedoc.json",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix --quiet",
    "test": "jest --config=./jest.config.js",
    "test:watch": "jest --watch --no-coverage --config=./jest.config.js",
    "test:coverage": "jest --coverage --config=./jest.config.js",
    "validate": "npm run lint && npm run test",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "default": "./dist/async/index.js"
    },
    "./is": {
      "types": "./dist/is/index.d.ts",
      "default": "./dist/is/index.js"
    },
    "./join": {
      "types": "./dist/join/index.d.ts",
      "default": "./dist/join/index.js"
    },
    "./split": {
      "types": "./dist/split/index.d.ts",
      "default": "./dist/split/index.js"
    },
    "./jsonl": {
      "types": "./dist/jsonl/index.d.ts",
      "default": "./dist/jsonl/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "default": "./dist/scheduler/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./rpc/browser": {
      "types": "./dist/rpc/browser/index.d.ts",
      "default": "./dist/rpc/browser/index.js"
    },
    "./rpc/node": {
      "types": "./dist/rpc/node/index.d.ts",
      "default": "./dist/rpc/node/index.js"
    }
  },
  "keywords": [
    "typescript",
    "utils",
    "utilities",
    "rpc",
    "async",
    "jsonl",
    "browser",
    "node",
    "string",
    "object",
    "array"
  ],
  "author": "Amir Absaliamov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-amirka/fundamentool.git"
  },
  "homepage": "https://github.com/mr-amirka/fundamentool#readme",
  "bugs": {
    "url": "https://github.com/mr-amirka/fundamentool/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "node-notifier": "^10.0.1",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "vitepress": "^1.6.4"
  }
}
